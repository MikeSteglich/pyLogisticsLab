%data
%display ignoreCons


par:
	M := len(destinations);
	
var:
	{ isRelaxed=1 || isSingleSource=0 : 
			x[edges] : real[0..1]; |
	  default : 
	  		x[edges] : binary;
	}
	y[sources]   : binary;
	# multi-source: u - the edge supplies a part, its distance counts for the bottleneck
	{ isSingleSource=0 && isRelaxed=0 : u[edges] : binary; }

	R : real;
	
obj:
	R -> min;
	  
con:
	{ isSingleSource=0 && isRelaxed=0 :
		{ [i,j] in edges: x[i,j] <= u[i,j] ; }
		{ isDemandWeighted = 0 :
			{ [i,j] in edges: c[i,j] *  u[i,j] <= R ; }
		  | isDemandWeighted = 1:
			{ [i,j] in edges: c[i,j] * d[j] * u[i,j] <= R ; }
		}
	  | default :
		{ isDemandWeighted = 0 :
			{ [i,j] in edges: c[i,j] *  x[i,j] <= R ; } 
		  | isDemandWeighted = 1: 	
		  	{ [i,j] in edges: c[i,j] * d[j] * x[i,j] <= R ; } 
		}
	}

	{ isRelaxed=0 : 
		{ [i,j] in fixedEdges,  i<>-1, j<>-1: 
			x[i,j] = 0;
		}
	}

	sum{ i  in sources: y[i] } = p;

	{j in destinations: sum{[i,j] in edges: x[i,j] } = 1; }

	{ 	isCap=0 : 
			{i in sources: sum {[i,j] in edges: x[i,j] } <= M * y[i]; } 
		| default : 
	  		{i in sources: sum {[i,j] in edges: d[j] * x[i,j] } <= s[i] * y[i]; }
	}
	
 
